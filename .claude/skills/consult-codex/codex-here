#!/usr/bin/env python3
"""codex-here — launch Codex in THIS project with the AWS reach this project's Claude has.

Tasks 30.2 / 30.3.  Usage:

    codex-here [--project DIR] [--dry-run] [--] <codex arguments...>

    codex-here                                  # interactive, this project
    codex-here exec 'review the current task'   # non-interactive
    codex-here exec resume <thread> 'round 2'   # the -c flags are re-passed, which resume needs

What it does, in order:
  1. Reads ~/.claude.json  ->  projects["<abs project>"].mcpServers
     Candidates are the entries whose COMMAND is the awslabs aws-api MCP server.
     By command, never by name: server names encode no account (rule 4 of the estate).
  2. Reads <project>/progress.json  ->  context_hints.aws_account (the declared primary).
  3. Binds exactly one candidate, or refuses:
        ACCOUNT-AMBIGUOUS  more than one candidate and no way to pick   (exit 3)
        ACCOUNT-NOT-BOUND  an account is declared but no server serves it (exit 3)
        no-infra           nothing declared, nothing configured -> launch WITHOUT AWS, say so
  4. Injects the bound server per invocation with -c mcp_servers.<name>.…  — every env
     key copied (the server does not inherit the parent's environment) plus
     READ_OPERATIONS_ONLY=true.  Nothing is written to any config file.
  5. Strips the SHELL of credentials (task 30.3): every AWS_* variable unset,
     AWS_EC2_METADATA_DISABLED=true, config/credentials paths pointed at /nonexistent.
     The injected server is unaffected: Codex starts MCP servers with a fresh minimal
     environment (HOME, PATH, … + the injected keys), so it still reads ~/.aws via HOME.
  6. execs codex.

Nothing here proves the binding is CORRECT — that is the caller's sts check
(see scripts/test-codex-here.sh).  This script only makes the binding explicit and visible.
"""
import json, os, shlex, sys

AWSLABS = "awslabs.aws-api-mcp-server"


def die(code, msg):
    print(f"codex-here: {msg}", file=sys.stderr)
    sys.exit(3 if code else 1)


def main(argv):
    project = os.getcwd()
    bind_from = None      # --bind-from <real checkout>: run in a CLONE, bind from the real project's entry
    dry = False
    args = list(argv)
    while args and args[0].startswith("--"):
        a = args.pop(0)
        if a == "--project":
            project = os.path.abspath(args.pop(0))
        elif a == "--bind-from":
            bind_from = os.path.realpath(args.pop(0))
        elif a == "--dry-run":
            dry = True
        elif a == "--":
            break
        else:
            die(1, f"unknown option {a}")
    project = os.path.realpath(project)
    bind_from = bind_from or project

    # 1. Claude's own MCP map for this project (keyed by the REAL checkout path)
    try:
        cj = json.load(open(os.path.expanduser("~/.claude.json")))
    except FileNotFoundError:
        cj = {}
    servers = ((cj.get("projects") or {}).get(bind_from) or {}).get("mcpServers") or {}
    cands = {n: s for n, s in servers.items()
             if os.path.basename(str(s.get("command", ""))) == AWSLABS}

    # 2. the declared primary account
    declared = None
    pj = os.path.join(bind_from, "progress.json")
    if os.path.exists(pj):
        try:
            declared = ((json.load(open(pj)).get("context_hints") or {}).get("aws_account"))
        except Exception as e:  # unreadable progress.json is the project's problem, not ours to hide
            print(f"codex-here: progress.json unreadable ({e}); treating as no declared account", file=sys.stderr)

    # 3. bind exactly one, or refuse, or no-infra
    flags = ['-c', 'project_doc_fallback_filenames=["CLAUDE.md"]', '-c', 'project_doc_max_bytes=262144']
    mode, bound = "no-infra", None
    if len(cands) == 1:
        bound = next(iter(cands.items()))
        mode = "aws-read-only"
    elif len(cands) > 1:
        die(3, f"ACCOUNT-AMBIGUOUS — {len(cands)} awslabs servers for {project}: "
               f"{', '.join(cands)}; declare ONE primary or pass --project to a narrower checkout")
    elif declared:
        die(3, f"ACCOUNT-NOT-BOUND — progress.json declares aws_account {declared} "
               f"but ~/.claude.json has no awslabs server for {project}")

    if bound:
        name, s = bound
        env = dict(s.get("env") or {})
        env["READ_OPERATIONS_ONLY"] = "true"
        toml_env = "{" + ",".join(f'{k}="{v}"' for k, v in env.items()) + "}"
        toml_args = "[" + ",".join(json.dumps(a) for a in (s.get("args") or [])) + "]"
        flags += ['-c', f'mcp_servers.{name}.command={json.dumps(s["command"])}',
                  '-c', f'mcp_servers.{name}.args={toml_args}',
                  '-c', f'mcp_servers.{name}.env={toml_env}']

    # 5. strip the shell of credentials; the injected server gets its own environment
    penv = {k: v for k, v in os.environ.items() if not k.startswith("AWS_")}
    penv.update({"AWS_EC2_METADATA_DISABLED": "true",
                 "AWS_CONFIG_FILE": "/nonexistent",
                 "AWS_SHARED_CREDENTIALS_FILE": "/nonexistent"})

    # codex accepts -c before the subcommand (global option); resume needs them re-passed each call
    cmd = ["codex"] + flags + args
    banner = (f"codex-here: {os.path.basename(project)} · mode={mode}"
              + (f" · server={bound[0]} · profile={bound[1].get('env', {}).get('AWS_PROFILE')}"
                 f" · declared={declared or '-'}" if bound else " · no AWS server, none declared"))
    print(banner, file=sys.stderr)
    if dry:
        print(" ".join(shlex.quote(c) for c in cmd))
        return 0
    os.chdir(project)
    os.execvpe("codex", cmd, penv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
